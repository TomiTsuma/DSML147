   "source": [
    "for index,row in report_data.iterrows():\n",
    "    print(index)\n",
    "    report_data_ = pd.DataFrame(row).T\n",
    "    if row['report_data'] == None:\n",
    "        continue\n",
    "    try:\n",
    "        _ = pd.DataFrame(report_data_[['report_data','barcode']].apply(lambda x: json.loads(x['report_data'])[x['barcode']]['results'], axis=1).tolist()[0])\n",
    "    except:\n",
    "        print(row['report_data'])\n",
    "        continue\n",
    "    _['spectral_sample_id'] = row['spectral_sample_id']\n",
    "    _['barcode'] = row['barcode']\n",
    "    _['crop_id'] = row['crop_id']\n",
    "    _ = _.replace(\"Very Low\",1).replace(\"Low\",1).replace(\"Optimum\",2).replace(\"High\",3).replace(\"Very High\",4).pivot_table(columns=\"chemical_name\", values=\"status\", index=\"barcode\")\n",
    "    reports = pd.concat([reports, _])\n"
   ]
  },
